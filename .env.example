# ============================================
# AnyRouter 自动签到 - 本地运行配置
# 复制此文件为 .env，填入你的信息
# 注意: JSON 内容必须是单行，不能换行
# ============================================

# --- 账号配置（必填）---
# 格式: JSON 数组，每个元素是一个账号
# 邮箱密码方式（推荐）:
#   {"name":"别名","provider":"anyrouter","email":"your@email.com","password":"your_password"}
# Session cookies 方式:
#   {"name":"别名","provider":"anyrouter","cookies":{"session":"xxx"},"api_user":"12345"}
ANYROUTER_ACCOUNTS=[{"name":"主账号","provider":"anyrouter","email":"your@email.com","password":"your_password"},{"name":"备用","provider":"agentrouter","email":"other@email.com","password":"other_password"}]

# --- 自定义 Provider（可选）---
# PROVIDERS={"custom":{"domain":"https://custom.example.com"}}

# --- 代理（可选，agentrouter 默认需要代理）---
# CHECKIN_PROXY_URL=http://127.0.0.1:7890
# PROXY_SUBSCRIPTION_URL=https://example.com/sub?token=xxx

# --- 调试模式（可选，开启截图和详细日志）---
# DEBUG_MODE=true

# --- 浏览器设置（可选）---
# CHECKIN_HEADLESS=false
# CHECKIN_HUMANIZE=true
# CHECKIN_WAIT_TIMEOUT_MS=120000

# --- 通知配置（可选，哪个需要就配置哪个）---
# EMAIL_USER=your@email.com
# EMAIL_PASS=your_password
# EMAIL_TO=receiver@email.com
# DINGDING_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# WEIXIN_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# PUSHPLUS_TOKEN=your_token
# SERVERPUSHKEY=your_key
# TELEGRAM_BOT_TOKEN=your_token
# TELEGRAM_CHAT_ID=your_chat_id
# GOTIFY_URL=https://your-gotify-server/message
# GOTIFY_TOKEN=your_token
# BARK_KEY=your_key
